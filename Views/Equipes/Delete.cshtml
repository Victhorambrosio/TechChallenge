@model TechChallenge.Models.Equipe

@{
    ViewData["Title"] = "Excluir equipe";
}

<div class="crud-form-page">
    <div class="crud-form-header">
        <h1 class="crud-form-title">Excluir equipe</h1>
        <p class="crud-form-subtitle mb-0">Confirme abaixo se deseja remover este registro.</p>
    </div>

    <div class="crud-form-panel">
        <div class="crud-delete-box">
            <p class="crud-delete-warning mb-3">Tem certeza que deseja excluir esta equipe?</p>

            <dl class="row crud-delete-list mb-0">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nome)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Nome)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Descricao)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Descricao)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DataCriacao)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.DataCriacao)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Ativa)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Ativa)</dd>
            </dl>
        </div>

        <form asp-action="Delete" class="crud-form-actions">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Excluir" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Voltar para a lista</a>
        </form>
    </div>
</div>
