@model TechChallenge.Models.Equipe

@{
    ViewData["Title"] = "Criar equipe";
}

<div class="crud-form-page">
    <div class="crud-form-header">
        <h1 class="crud-form-title">Criar equipe</h1>
        <p class="crud-form-subtitle mb-0">Preencha os dados abaixo para adicionar uma nova equipe.</p>
    </div>

    <div class="crud-form-panel">
        <div class="crud-form-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label"></label>
                    <input asp-for="Descricao" class="form-control" />
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DataCriacao" class="form-label"></label>
                    <input asp-for="DataCriacao" class="form-control" />
                    <span asp-validation-for="DataCriacao" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Ativa" />
                    <label class="form-check-label" asp-for="Ativa"></label>
                </div>

                <div class="crud-form-actions">
                    <input type="submit" value="Salvar" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Voltar para a lista</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
