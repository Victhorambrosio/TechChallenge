@model IEnumerable<TechChallenge.Aluno>

@{
    ViewData["Title"] = "Alunos";
}

<div class="crud-page">
    <div class="crud-hero">
        <h1 class="crud-title">Alunos</h1>
        <p class="crud-subtitle mb-0">Cadastro e gerenciamento dos alunos.</p>
    </div>

    <div class="crud-panel">
        <div class="crud-toolbar">
            <a asp-action="Create" class="btn btn-primary">Criar novo</a>
        </div>

        <div class="crud-table-wrap">
            <table class="table crud-table align-middle">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Nome)</th>
                        <th>@Html.DisplayNameFor(model => model.Email)</th>
                        <th>@Html.DisplayNameFor(model => model.Telefone)</th>
                        <th>@Html.DisplayNameFor(model => model.DataNascimento)</th>
                        <th>@Html.DisplayNameFor(model => model.DataCadastro)</th>
                        <th>@Html.DisplayNameFor(model => model.Ativo)</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>@Html.DisplayFor(modelItem => item.Telefone)</td>
                        <td>@Html.DisplayFor(modelItem => item.DataNascimento)</td>
                        <td>@Html.DisplayFor(modelItem => item.DataCadastro)</td>
                        <td>@Html.DisplayFor(modelItem => item.Ativo)</td>
                        <td>
                            <div class="crud-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
