@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "Cadastro de Usuários";
    var rolesUsuario = ViewBag.rolesUsuarios as Dictionary<string, string>;
}

<a asp-action="CriarUsuario" class="usuario-novo-btn">
    NOVO USUÁRIO
</a>
<div class="table-reponsive">
    <table class="table">
        <thead class="table-hover">
            <tr>
                <th>E-MAIL</th>
                <th>PERFIL</th>
                <th>AÇÕES</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var usuario in Model)
                {
                    <tr>
                        <td>
                            @usuario.Email
                        </td>
                        <td>
                            <div class="usuario-acoes">

                                @if (rolesUsuario != null &&
                                     rolesUsuario.TryGetValue(usuario.Id, out var perfil) &&
                                     perfil == "Admin")
                                {
                                    <span class="usuario-admin-badge">
                                        ADMIN
                                    </span>
                                }
                                else
                                {
                                    <a asp-action="TornarAdmin" asp-route-id="@usuario.Id" class="usuario-btn usuario-btn--admin">
                                        TORNAR ADMIN
                                    </a>
                                }

                                <a asp-action="EditarUsuario" asp-route-id="@usuario.Id"
                                   class="usuario-btn usuario-btn--editar">
                                    EDITAR
                                </a>

                                <a asp-action="TrocarPerfil" asp-route-id="@usuario.Id" class="usuario-btn usuario-btn--perfil">
                                    TROCAR PERFIL
                                </a>

                                <a asp-action="ExcluirUsuario" asp-route-id="@usuario.Id"
                                   class="usuario-btn usuario-btn--excluir">
                                    EXCLUIR
                                </a>

                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center py-4">
                        Nenhum Usuário Cadastrado.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


</div>