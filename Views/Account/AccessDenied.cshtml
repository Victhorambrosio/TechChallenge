@{
    ViewData["Title"] = "Acesso negado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger text-center">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Acesso negado</h4>
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-shield-lock" style="font-size: 60px;"></i>
                    </div>

                    <h5>Você não possui permissão para acessar esta página.</h5>
                    <p class="text-muted mt-3">
                        Entre em contato com o administrador caso acredite que isso seja um erro.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary mt-3">
