@model IEnumerable<TechChallenge.Models.Projeto>

@{
    ViewData["Title"] = "Projetos";
}

<div class="crud-page">
    <div class="crud-hero">
        <h1 class="crud-title">Projetos</h1>
        <p class="crud-subtitle mb-0">Cadastro e gerenciamento dos projetos.</p>
    </div>

    <div class="crud-panel">
        <div class="crud-toolbar">
            <a asp-action="Create" class="btn btn-primary">Criar novo</a>
        </div>

        <div class="crud-table-wrap">
            <table class="table crud-table align-middle">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Nome)</th>
                        <th>@Html.DisplayNameFor(model => model.Descricao)</th>
                        <th>@Html.DisplayNameFor(model => model.DataInicio)</th>
                        <th>@Html.DisplayNameFor(model => model.DataFim)</th>
                        <th>@Html.DisplayNameFor(model => model.Pontuacao)</th>
                        <th>@Html.DisplayNameFor(model => model.Professor)</th>
                        <th>@Html.DisplayNameFor(model => model.Categoria)</th>
                        <th>@Html.DisplayNameFor(model => model.Equipe)</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                        <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                        <td>@Html.DisplayFor(modelItem => item.DataInicio)</td>
                        <td>@Html.DisplayFor(modelItem => item.DataFim)</td>
                        <td>@Html.DisplayFor(modelItem => item.Pontuacao)</td>
                        <td>@Html.DisplayFor(modelItem => item.Professor.Email)</td>
                        <td>@Html.DisplayFor(modelItem => item.Categoria.Nome)</td>
                        <td>@Html.DisplayFor(modelItem => item.Equipe.Nome)</td>
                        <td>
                            <div class="crud-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
