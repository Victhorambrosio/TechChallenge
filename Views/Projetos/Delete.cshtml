@model TechChallenge.Models.Projeto

@{
    ViewData["Title"] = "Excluir projeto";
}

<div class="crud-form-page">
    <div class="crud-form-header">
        <h1 class="crud-form-title">Excluir projeto</h1>
        <p class="crud-form-subtitle mb-0">Confirme abaixo se deseja remover este registro.</p>
    </div>

    <div class="crud-form-panel">
        <div class="crud-delete-box">
            <p class="crud-delete-warning mb-3">Tem certeza que deseja excluir este projeto?</p>

            <dl class="row crud-delete-list mb-0">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nome)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Nome)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Descricao)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Descricao)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DataInicio)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.DataInicio)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DataFim)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.DataFim)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Pontuacao)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Pontuacao)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Professor)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Professor.Email)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Categoria)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Categoria.Nome)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Equipe)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Equipe.Nome)</dd>
            </dl>
        </div>

        <form asp-action="Delete" class="crud-form-actions">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Excluir" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Voltar para a lista</a>
        </form>
    </div>
</div>
