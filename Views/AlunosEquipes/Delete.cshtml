@model TechChallenge.Models.AlunoEquipe

@{
    ViewData["Title"] = "Excluir vínculo";
}

<div class="crud-form-page">
    <div class="crud-form-header">
        <h1 class="crud-form-title">Excluir vínculo</h1>
        <p class="crud-form-subtitle mb-0">Confirme abaixo se deseja remover este vínculo entre aluno e equipe.</p>
    </div>

    <div class="crud-form-panel">
        <div class="crud-delete-box">
            <p class="crud-delete-warning mb-3">Tem certeza que deseja excluir este vínculo?</p>

            <dl class="row crud-delete-list mb-0">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Aluno)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Aluno.Id)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Equipe)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Equipe.Nome)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DataEntrada)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.DataEntrada)</dd>
            </dl>
        </div>

        <form asp-action="Delete" class="crud-form-actions">
            <input type="hidden" asp-for="AlunoId" />
            <input type="hidden" asp-for="EquipeId" />
            <input type="submit" value="Excluir" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Voltar para a lista</a>
        </form>
    </div>
</div>
