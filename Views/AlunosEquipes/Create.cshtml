@model TechChallenge.Models.AlunoEquipe

@{
    ViewData["Title"] = "Criar vínculo";
}

<div class="crud-form-page">
    <div class="crud-form-header">
        <h1 class="crud-form-title">Criar vínculo</h1>
        <p class="crud-form-subtitle mb-0">Associe um aluno a uma equipe.</p>
    </div>

    <div class="crud-form-panel">
        <div class="crud-form-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="AlunoId" class="form-label"></label>
                    <select asp-for="AlunoId" class="form-select" asp-items="ViewBag.AlunoId"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="EquipeId" class="form-label"></label>
                    <select asp-for="EquipeId" class="form-select" asp-items="ViewBag.EquipeId"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="DataEntrada" class="form-label"></label>
                    <input asp-for="DataEntrada" class="form-control" />
                    <span asp-validation-for="DataEntrada" class="text-danger"></span>
                </div>

                <div class="crud-form-actions">
                    <input type="submit" value="Salvar" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Voltar para a lista</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
