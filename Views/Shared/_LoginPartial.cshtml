@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="d-flex justify-content-center align-items-center">
        <span class="tc-account-name">
            @User.Identity?.Name
        </span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="tc-logout-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="tc-nav-button tc-nav-button-danger">
                <span>SAIR</span>
                <strong>↗</strong>
            </button>
        </form>
    </div>

}
else
{

    <div class="tc-auth-nav d-flex align-items-center gap-2 flex-nowrap">

        <form asp-controller="Account" asp-action="Register" method="get" class="m-0">
            <button type="submit" class="tc-nav-button tc-nav-button-register btn btn-light">
                REGISTRAR-SE
            </button>
        </form>

        <form asp-controller="Account" asp-action="Login" method="get" class="m-0">
            <button type="submit" class="tc-nav-button tc-nav-button-login btn btn-light">
                ENTRAR
            </button>
        </form>

    </div>
}